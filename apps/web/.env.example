# Développement local
NEXT_PUBLIC_STATIC_EXPORT=false
NEXT_PUBLIC_PORTFOLIO_MODE=false
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_VORZIX_URL=https://vorzix.com

# Build local type Netlify (sans fichier .env.production.local)
# NEXT_PUBLIC_STATIC_EXPORT=true
# NEXT_PUBLIC_PORTFOLIO_MODE=true
# NEXT_PUBLIC_BASE_PATH=
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Build vorzix.com (sous-chemin) — ou branche `vorzix` sur Netlify
# NEXT_PUBLIC_STATIC_EXPORT=true
# NEXT_PUBLIC_PORTFOLIO_MODE=true
# NEXT_PUBLIC_BASE_PATH=/demos/savoraille
# NEXT_PUBLIC_SITE_URL=https://vorzix.com/demos/savoraille

# Cloudflare Pages : voir wrangler.toml à la racine du repo
