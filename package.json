{
  "name": "savoraill",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @savoraill/web dev",
    "dev:api": "pnpm --filter @savoraill/api start:dev",
    "build:web": "pnpm --filter @savoraill/web build",
    "build:netlify": "NEXT_PUBLIC_STATIC_EXPORT=true NEXT_PUBLIC_PORTFOLIO_MODE=true NEXT_PUBLIC_BASE_PATH= NEXT_PUBLIC_VORZIX_URL=https://vorzix.com pnpm --filter @savoraill/web build:netlify",
    "build:cloudflare": "pnpm build:netlify",
    "build:web:portfolio": "pnpm build:netlify",
    "deploy:cloudflare": "node -e \"require('fs').accessSync('apps/web/out')\" && wrangler deploy",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "wrangler": "^4.128.0"
  }
}
