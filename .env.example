NODE_ENV=development

# PostgreSQL
POSTGRES_DB=savoraill
POSTGRES_USER=savoraill
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql://savoraill:change-me-locally@localhost:5432/savoraill?schema=public

# MinIO
MINIO_ROOT_USER=savoraill
MINIO_ROOT_PASSWORD=change-me-locally
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=savoraill-images

# API and web
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Local email (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@savoraill.local
